{
  "name": "public-web-qa",
  "version": "1.0.0",
  "scripts": {
    "postinstall": "npx playwright install",
    "test": "cucumber-js --format summary",
    "test:smoke": "cucumber-js --tags @smoke --format summary",
    "test:regression": "cucumber-js --tags @regression --format summary",
    "test:ui": "cucumber-js --tags @ui --format summary",
    "test:api": "cucumber-js --tags @api --format summary",
    "test:chromium": "cross-env BROWSER=chromium npm run test:ui",
    "test:firefox": "cross-env BROWSER=firefox npm run test:ui",
    "test:webkit": "cross-env BROWSER=webkit npm run test:ui",
    "test:browsers": "npm run test:chromium && npm run test:webkit",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:clean": "node -e \"['allure-results','allure-report'].forEach((dir) => require('fs').rmSync(dir, { recursive: true, force: true }))\"",
    "allure:single-html": "allure generate allure-results --clean --single-file -o allure-report",
    "report:allure": "npm run allure:generate",
    "open:allure": "allure open allure-report"
  },
  "license": "ISC",
  "description": "A small public-site UI and API test suite using Playwright, TypeScript, and Cucumber.",
  "devDependencies": {
    "@cucumber/cucumber": "^12.0.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "allure-commandline": "^2.34.1",
    "allure-cucumberjs": "^3.4.0",
    "cross-env": "^10.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "glob": "^14.0.3"
  }
}